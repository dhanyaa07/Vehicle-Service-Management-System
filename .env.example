# Default backend is portable SQLite. Set to mysql to use MySQL 8.0.16+.
DB_BACKEND=sqlite
DB_PATH=data/vehicle_service.db

# MySQL settings (used only when DB_BACKEND=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vehicle_service_db
DB_USER=root
DB_PASSWORD=
DB_CONNECT_TIMEOUT=8

# SQLite seeds a small fictional workshop dataset on first launch by default.
# Set to 0 for an empty database, or 1 to seed an empty MySQL database.
SEED_DEMO=1
